# Copy to .env.local and fill in. .env.local is git-ignored; never commit real values.
# Setup steps: README.md, "Form emails".

# Resend API key (required in production; without it development only logs submissions)
RESEND_API_KEY=
# Inbox that receives every form submission (required whenever a key is set)
LEADS_TO_EMAIL=
# Sender, e.g. CCC Website <leads@yourdomain> once that domain is verified in Resend (required in production)
LEADS_FROM_EMAIL=
# "true" also emails the submitter a short confirmation (needs a verified domain). Off by default.
SEND_CONFIRMATION_EMAIL=

# Optional: only for scripts/fetch-assets.mjs
PEXELS_API_KEY=
